exclusions: list(
    # Template copied into user projects by use_function_template(); its helpers exist there, not here.
    "inst/templates/function_template.R",
    # Standard testthat runner generated by usethis ("do not modify"); library(fmisc) is intended.
    "tests/testthat.R",
    # air puts the `{` after `%dopar%` on its own line; brace_linter would demand the opposite.
    "R/smart_parallel.R" = list(brace_linter = Inf)
  )
